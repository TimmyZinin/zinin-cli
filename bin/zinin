#!/usr/bin/env bash
# Zinin OS — локальный интерфейс. Старый REPL доступен через `zinin repl`.
set -euo pipefail
ZININ_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v bun >/dev/null 2>&1; then
  echo "zinin: нужен установленный Bun" >&2
  exit 127
fi
exec bun "$ZININ_HOME/src/cli.ts" "$@"
